{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ModernSelfHost/openappstore/schema/app.schema.json",
  "title": "openappstore app manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "description", "category", "runtime"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": ["string", "number", "integer"],
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "media",
        "files",
        "network",
        "home",
        "dev",
        "productivity",
        "security",
        "monitoring",
        "database",
        "utilities"
      ]
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "enum": ["compose", "qemu"]
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "inline": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        { "required": ["file"] },
        { "required": ["inline"] }
      ]
    },
    "qemu": {
      "type": "object",
      "required": ["image", "machine", "network"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "required": ["url", "sha256", "format"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "format": {
              "type": "string",
              "enum": ["qcow2", "raw", "vmdk", "img"]
            },
            "compression": {
              "type": "string",
              "enum": ["none", "xz", "gz", "zst", "bz2"]
            }
          }
        },
        "machine": {
          "type": "object",
          "required": ["arch", "cpus", "memory", "disk"],
          "additionalProperties": false,
          "properties": {
            "arch": {
              "type": "string",
              "enum": ["x86_64", "aarch64"]
            },
            "cpus": {
              "type": "integer",
              "minimum": 1
            },
            "memory": {
              "type": "integer",
              "minimum": 128
            },
            "disk": {
              "type": "string",
              "pattern": "^[0-9]+[A-Za-z]*$"
            },
            "uefi": {
              "type": "boolean"
            }
          }
        },
        "network": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["user", "bridge"]
            },
            "forward": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["host", "guest", "proto"],
                "additionalProperties": false,
                "properties": {
                  "host": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "guest": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "proto": { "type": "string", "enum": ["tcp", "udp"] }
                }
              }
            }
          }
        },
        "devices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usb": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "integer", "minimum": 1 },
        "ram": { "type": "integer", "minimum": 1 },
        "disk": { "type": "string" },
        "arch": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "runtime": { "const": "compose" } } },
      "then": { "required": ["compose"] }
    },
    {
      "if": { "properties": { "runtime": { "const": "qemu" } } },
      "then": { "required": ["qemu"] }
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["string", "number", "bool", "port", "path", "password", "select"]
        },
        "default": {},
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array"
        },
        "help": {
          "type": "string"
        },
        "binds": {
          "type": "string",
          "minLength": 1
        },
        "generate": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "select" } } },
          "then": { "required": ["options"] }
        }
      ]
    }
  }
}